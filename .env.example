# Copy to .env (gitignored) and fill in. See docs/01-accounts-and-infra.md.

# GitHub bot (codecrafterbot) — classic PAT, scope public_repo only
GITHUB_TOKEN=

# Jira (bot account)
JIRA_BASE_URL=https://code-crafter.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Claude — from `claude setup-token` (Pro/Max) — or ANTHROPIC_API_KEY for pay-as-you-go
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub webhooks → smee → n8n (Phase 0/1c)
SMEE_URL=
GITHUB_WEBHOOK_SECRET=

# Slack app (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TRIGGER_CHANNEL_ID=
SLACK_ALLOWED_USER_IDS=

# GitHub logins whose PR comments/reviews may drive the agent (D17), comma-separated
GITHUB_ALLOWED_USERS=

# Shared secret between n8n and the control plane — generate: openssl rand -hex 24
INTERNAL_API_TOKEN=

# Optional timer overrides (minutes) — defaults per D16
# CC_SOFT_TIMEOUT_MIN=10
# CC_MAX_CONTINUATIONS=3
# CC_IDLE_TTL_MIN=40
# CC_HARD_CAP_MIN=90
# CC_GRACE_MIN=2
