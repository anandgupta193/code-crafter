# Copy to .env (gitignored) and fill in. Step-by-step: README → "Set it up yourself".

# GitHub bot account — classic PAT: scope public_repo (public repos) or repo (private repos)
GITHUB_TOKEN=
# Commit identity inside the agent container (the bot's name + its no-reply email from GitHub → Settings → Emails)
GIT_USER_NAME=
GIT_USER_EMAIL=

# Jira (bot account)
JIRA_BASE_URL=https://code-crafter.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira project that #ops messages become Stories in
JIRA_PROJECT_KEY=SCRUM

# Claude — from `claude setup-token` (Pro/Max) — or ANTHROPIC_API_KEY for pay-as-you-go
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub webhooks → smee → n8n (Phase 0/1c)
SMEE_URL=
GITHUB_WEBHOOK_SECRET=

# Slack app (Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TRIGGER_CHANNEL_ID=
# #ops: any message here becomes a Jira Story (optional)
SLACK_OPS_CHANNEL_ID=
SLACK_ALLOWED_USER_IDS=

# GitHub logins whose PR comments/reviews may drive the agent (D17), comma-separated
GITHUB_ALLOWED_USERS=

# Shared secret between n8n and the control plane — generate: openssl rand -hex 24
INTERNAL_API_TOKEN=

# Optional timer overrides (minutes) — defaults per D16
# CC_SOFT_TIMEOUT_MIN=10
# CC_MAX_CONTINUATIONS=3
# CC_IDLE_TTL_MIN=40
# CC_HARD_CAP_MIN=90
# CC_GRACE_MIN=2

# Phase 2 context graph (docs/10-context-graph.md) — generate: openssl rand -hex 16. Leave empty to run without the graph.
NEO4J_PASSWORD=
# Ollama for embeddings; the default reaches Ollama on the host via Docker Desktop
# OLLAMA_URL=http://host.docker.internal:11434
